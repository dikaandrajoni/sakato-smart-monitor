# Copy menjadi .env dan isi nilai aslinya. JANGAN commit file .env.

# Telegram (buat via @BotFather, jangan pakai token lama yang pernah publik)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MQTT (dipakai Frigate <-> Home Assistant <-> agent)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Kamera (contoh; tambah sesuai jumlah kamera)
CAMERA_1_RTSP=rtsp://user:pass@192.168.1.10:554/stream1

# Agent LLM (salah satu; default lokal via Ollama)
OLLAMA_HOST=http://localhost:11434
# OPENAI_API_KEY=   # opsional, hanya bila pakai model cloud
